---
// Reusable document shell for the Astro build. Head fields are props so future
// pages (writing section, forge docs) can supply their own title/description/OG
// values while keeping the same font + meta scaffold. Page-specific head
// content (inline <style>, JSON-LD, etc.) is injected via the "head" slot.
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogUrl?: string;
  ogType?: string;
  ogSiteName?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  author?: string;
}

const {
  title = 'Scott Feltham — Creator of FORGE · Intent-Driven Development',
  description = 'Scott Feltham: engineering leader, creator of FORGE and Intent-Driven Development. CTO running a multi-product production AI platform as a one-person engineering org.',
  canonical = 'https://scottfeltham.com/',
  ogTitle = 'Scott Feltham — Intent-Driven Development',
  ogDescription = 'The quality of AI output is determined by the quality of the intent you express. Creator of FORGE.',
  ogUrl = 'https://scottfeltham.com/',
  ogType = 'website',
  ogSiteName = 'Scott Feltham',
  ogImage = 'https://scottfeltham.com/assets/og-image.png',
  ogImageWidth = '1200',
  ogImageHeight = '630',
  twitterCard = 'summary_large_image',
  twitterTitle = 'Scott Feltham — Intent-Driven Development',
  twitterDescription = 'The quality of AI output is determined by the quality of the intent you express. Creator of FORGE.',
  twitterImage = 'https://scottfeltham.com/assets/og-image.png',
  author = 'Scott Feltham',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <meta name="author" content={author} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={ogSiteName} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={ogImageWidth} />
  <meta property="og:image:height" content={ogImageHeight} />
  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:title" content={twitterTitle} />
  <meta name="twitter:description" content={twitterDescription} />
  <meta name="twitter:image" content={twitterImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;1,9..144,300;1,9..144,400;1,9..144,600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
