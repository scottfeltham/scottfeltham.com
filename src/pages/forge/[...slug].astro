---
import { getCollection, render } from 'astro:content';
import ForgeLayout from '../../layouts/ForgeLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('forge');
  return entries
    .filter((e) => e.data.permalink !== '/forge/')
    .map((e) => ({
      // permalink "/forge/implementations/" -> slug "implementations"; with
      // build.format 'directory' this emits dist/forge/implementations/index.html,
      // served at /forge/implementations/ — matching the live Jekyll permalink.
      params: { slug: e.data.permalink.replace(/^\/forge\//, '').replace(/\/$/, '') },
      props: { entry: e },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ForgeLayout url={entry.data.permalink} title={entry.data.title} description={entry.data.description} parent={entry.data.parent}>
  <Content />
</ForgeLayout>
